{
  "name": "research-radar",
  "type": "module",
  "version": "0.2.0",
  "description": "Surfaces newly published research from your journals, ranked and explained, inside Zotero",
  "config": {
    "addonName": "Research Radar",
    "addonID": "researchradar@korhonenaleksi.github.io",
    "addonRef": "researchradar",
    "addonInstance": "ResearchRadar",
    "prefsPrefix": "extensions.zotero.researchradar"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KorhonenAleksi/research-radar.git"
  },
  "author": "Aleksi Korhonen",
  "bugs": {
    "url": "https://github.com/KorhonenAleksi/research-radar/issues"
  },
  "homepage": "https://github.com/KorhonenAleksi/research-radar#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "update-deps": "npm update --save",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:zotero": "zotero-plugin test",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "stemmer": "^2.0.1",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
